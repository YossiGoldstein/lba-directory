{
  "name": "AiInteraction",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "User who asked the question"
    },
    "question": {
      "type": "string",
      "description": "User's question to the AI"
    },
    "agent_response": {
      "type": "string",
      "description": "AI assistant's response"
    },
    "conversation_id": {
      "type": "string",
      "description": "Conversation ID for continuity"
    },
    "page_context": {
      "type": "string",
      "description": "Where the question was asked (home, category, business)"
    },
    "business_id": {
      "type": "string",
      "description": "Business ID if asked from business page"
    }
  },
  "required": [
    "user_id",
    "question"
  ]
}