{
  "name": "Notification",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string",
      "description": "Customer who receives the notification"
    },
    "business_id": {
      "type": "string",
      "description": "Related business"
    },
    "deal_id": {
      "type": "string",
      "description": "Related deal"
    },
    "type": {
      "type": "string",
      "enum": [
        "new_deal",
        "deal_ending_soon",
        "business_update"
      ],
      "default": "new_deal",
      "description": "Notification type"
    },
    "title": {
      "type": "string",
      "description": "Notification title"
    },
    "message": {
      "type": "string",
      "description": "Notification message"
    },
    "is_read": {
      "type": "boolean",
      "default": false,
      "description": "Has user read this notification"
    },
    "email_sent": {
      "type": "boolean",
      "default": false,
      "description": "Was email sent for this notification"
    }
  },
  "required": [
    "customer_id",
    "business_id",
    "type",
    "title",
    "message"
  ]
}