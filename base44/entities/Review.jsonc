{
  "name": "Review",
  "type": "object",
  "properties": {
    "business_id": {
      "type": "string",
      "description": "Business being reviewed"
    },
    "user_id": {
      "type": "string",
      "description": "User who wrote the review"
    },
    "general_rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "General rating (1-5)"
    },
    "servicing_rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "Servicing rating (1-5)"
    },
    "pricing_rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5,
      "description": "Pricing rating (1-5)"
    },
    "is_approved": {
      "type": "boolean",
      "default": true,
      "description": "Moderation approval status"
    }
  },
  "required": [
    "business_id",
    "general_rating",
    "servicing_rating",
    "pricing_rating"
  ]
}