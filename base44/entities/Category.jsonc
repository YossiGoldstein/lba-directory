{
  "name": "Category",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Category name"
    },
    "slug": {
      "type": "string",
      "description": "URL-friendly slug"
    },
    "description": {
      "type": "string",
      "description": "Category description"
    },
    "icon_name": {
      "type": "string",
      "description": "Icon name for UI (lucide-react icon name or emoji)"
    },
    "parent_category_id": {
      "type": "string",
      "description": "Parent category ID for subcategories"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Is category active"
    }
  },
  "required": [
    "name",
    "slug"
  ]
}