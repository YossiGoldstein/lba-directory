{
  "name": "Customer",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "description": "Customer full name"
    },
    "email": {
      "type": "string",
      "description": "Customer email address"
    },
    "phone": {
      "type": "string",
      "description": "Customer phone number"
    },
    "password_hash": {
      "type": "string",
      "description": "Hashed password"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Is account active"
    },
    "role": {
      "type": "string",
      "enum": [
        "user",
        "admin"
      ],
      "default": "user",
      "description": "Account role (user or admin)"
    }
  },
  "required": [
    "full_name",
    "email",
    "password_hash"
  ]
}