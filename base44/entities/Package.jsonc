{
  "name": "Package",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Package name"
    },
    "slug": {
      "type": "string",
      "description": "URL-friendly slug"
    },
    "description_short": {
      "type": "string",
      "description": "Short description"
    },
    "description_long": {
      "type": "string",
      "description": "Full description"
    },
    "price_per_month": {
      "type": "number",
      "default": 0,
      "description": "Monthly price (0 for free)"
    },
    "billing_period_type": {
      "type": "string",
      "enum": [
        "monthly",
        "yearly",
        "one_time"
      ],
      "default": "monthly",
      "description": "Billing period"
    },
    "is_free": {
      "type": "boolean",
      "default": false,
      "description": "Is this a free plan"
    },
    "is_for_sponsors": {
      "type": "boolean",
      "default": false,
      "description": "LBA sponsor exclusive"
    },
    "max_listings": {
      "type": "number",
      "default": 1,
      "description": "Maximum number of listings"
    },
    "can_add_photos": {
      "type": "boolean",
      "default": true,
      "description": "Can add photos"
    },
    "max_photos": {
      "type": "number",
      "description": "Maximum photos allowed"
    },
    "can_add_videos": {
      "type": "boolean",
      "default": false,
      "description": "Can add videos"
    },
    "can_feature_business": {
      "type": "boolean",
      "default": false,
      "description": "Can feature business"
    },
    "can_see_stats": {
      "type": "boolean",
      "default": true,
      "description": "Can see analytics/stats"
    },
    "can_create_deals": {
      "type": "boolean",
      "default": true,
      "description": "Can create deals/promotions"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Is package available"
    }
  },
  "required": [
    "name",
    "slug"
  ]
}