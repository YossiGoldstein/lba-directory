{
  "name": "ActivityLog",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "User who performed the action (null for system actions)"
    },
    "action_type": {
      "type": "string",
      "description": "Type of action (e.g. create_business, update_business, approve_business)"
    },
    "target_type": {
      "type": "string",
      "description": "Entity type affected (e.g. Business, Review, User)"
    },
    "target_id": {
      "type": "string",
      "description": "ID of affected entity"
    },
    "details": {
      "type": "string",
      "description": "Additional details (JSON or text)"
    }
  },
  "required": [
    "action_type",
    "target_type",
    "target_id"
  ]
}